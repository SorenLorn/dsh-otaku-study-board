# ── 依赖 ──────────────────────────────────────────────
node_modules/

# ── 构建 / 测试产物（可由 build + 测试命令重新生成）──
scripts/ui/.build/
scripts/ui/.build-*/
smoke.cjs
*.tsbuildinfo

# ── 截图与度量产物（scripts/ui/*-shot.mjs、*-browser.test.mjs 生成）──
# reports/ 只是产物目录：图片、JSON 一律不入库；
# 阶段报告 / 审计记录 / 开发总结同样不许入库 —— 公开文档只有根目录那 5 份 md。
reports/*
!reports/.gitkeep

# ── npm 打包产物 ──────────────────────────────────────
*.tgz

# ── 本机 / 工具状态 ───────────────────────────────────
.workbuddy/
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# ── 环境变量 ──────────────────────────────────────────
.env
.env.*
!.env.example

# ── npm 缓存 ──────────────────────────────────────────
.npm
